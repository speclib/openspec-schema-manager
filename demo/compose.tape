Output demo/compose.gif

Set Shell bash
Set FontSize 15
Set Width 1200
Set Height 700
Set Padding 12
Set TypingSpeed 60ms

Hide
Type "cd $(git rev-parse --show-toplevel)" Enter
Type "export XDG_CONFIG_HOME=$PWD/demo/.work/config XDG_CACHE_HOME=$PWD/demo/.work/cache XDG_STATE_HOME=$PWD/demo/.work/state" Enter
Type "clear" Enter
Show

Type "ossm" Enter
Sleep 2s

Type "3"
Sleep 1500ms
Type "p"
Sleep 1s
Type "j"
Type "p"
Sleep 1s

Type "4"
Sleep 2s

Type "j"
Type "a"
Sleep 1500ms
Type "jjj"
Type "a"
Sleep 2s

Right
Sleep 500ms
Type "j"
Type "l"
Sleep 1500ms
Enter
Sleep 1500ms

Type "g"
Sleep 1s
Type "t"
Type "tasks.md"
Enter
Sleep 2s

Type "d"
Sleep 3s
Type "d"
Sleep 1s

Type "q"
Sleep 500ms
