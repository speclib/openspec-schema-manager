Output demo/install.gif

Set Shell bash
Set FontSize 15
Set Width 1200
Set Height 700
Set Padding 12
Set TypingSpeed 60ms

Hide
Type "cd $(git rev-parse --show-toplevel)" Enter
Type "export XDG_CONFIG_HOME=$PWD/demo/.work/config XDG_CACHE_HOME=$PWD/demo/.work/cache XDG_STATE_HOME=$PWD/demo/.work/state" Enter
Type "clear" Enter
Show

Type "cd demo/.work/demo-app" Enter
Type "clear" Enter
Type "ossm" Enter
Sleep 3s

Sleep 2s
Type "2"
Sleep 2s

Type "g"
Sleep 500ms
Type "i"
Sleep 3s

Type "y"
Sleep 3s
Enter
Sleep 500ms

Type "1"
Sleep 3s

Type "q"
Sleep 500ms
